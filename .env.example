
### LOCAL/TARGET DB CONFIG
DB_NAME=music_product_db
DB_USER=...
DB_PASSWORD=...
DB_HOST=localhost
DB_PORT=5432

# For accessing postgres from outside docker
PG_HOST_PORT=5434

# running on host db
DATABASE_URL=postgresql+asyncpg://<DB_USER>:<DB_PASSWORD>@localhost:5432/music_product_db
#DATABASE_URL=postgresql+asyncpg://<db_user>:<db_password>@<remote_db_host_here>:<remote_db_port_here>/<db_name>

# PostgreSQL Superuser
POSTGRES_PASSWORD=admin
POSTGRES_USER=postgres
POSTGRES_DB=postgres

### RabbitMQ config
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
# RabbitMQ Queue settings
REQUEST_QUEUE=rag.requests
RESPONSE_QUEUE=rag.responses
CALLBACK_QUEUE=rag.callbacks
EXCHANGE_NAME=rag.direct

### Utility config CUDA/MODELS
CUDA_VISIBLE_DEVICES=0

### LLM service config
LLM_API_URL=http://vllm_llm:8000/v1
LLM_MODEL=Qwen/Qwen3.5-0.8B
LLM_MODEL_SERVICE_PORT=8000

### Embedding service config
EMBEDDING_API_URL=http://vllm_emb:8004/v1/embeddings
EMBEDDING_MODEL=ibm-granite/granite-embedding-311m-multilingual-r2
EMBEDDING_DIM=768
EMBEDDING_MODEL_SERVICE_PORT=8004

# host is the service name that is used in docker (vllm_reranker)
RERANKER_API_URL=http://vllm_reranker:8006/v2/rerank
#RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANKER_MODEL=ibm-granite/granite-embedding-reranker-english-r2
RERANKER_MODEL_SERVICE_PORT=8006

# Set this to server specific path
LOCAL_HF_CACHE_PATH=...   # e.g ~/.cache/huggingface
